{
  "name": "codex-limit-telegram-bot",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "lab": "node scripts/lab.mjs",
    "dev": "wrangler dev",
    "dashboard:dev": "wrangler dev --config wrangler.dashboard.toml --var OPENROUTER_MODEL:nvidia/nemotron-3-ultra-550b-a55b:free --var PUBLIC_SUBSCRIPTIONS_ENABLED:true --var TARGET_USERNAMES:thsottiaux,sama",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test",
    "db:migrate:local": "wrangler d1 migrations apply codex-limit-telegram-subscriptions --local",
    "db:migrate:remote": "wrangler d1 migrations apply codex-limit-telegram-subscriptions --remote"
  },
  "dependencies": {
    "rettiwt-api": "^7.0.2"
  },
  "devDependencies": {
    "esbuild": "^0.28.0",
    "@cloudflare/workers-types": "latest",
    "typescript": "latest",
    "vitest": "latest",
    "wrangler": "latest"
  }
}
